{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "AppDBContext": "Server=localhost;Database=TicketDB;User Id=sa;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Secret": "YOUR_JWT_SECRET_KEY_HERE",
    "Issuer": "http://localhost:5000",
    "Audience": "http://localhost:5000",
    "ExpiryInMinutes": 60
  },
  "AllowedHosts": "*",
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "Tickets:"
  },
  "MailSettings": {
    "Email": "your-email@gmail.com",
    "DisplayName": "Ticketat",
    "Password": "YOUR_APP_PASSWORD",
    "Host": "smtp.gmail.com",
    "Port": 465
  },
  "PaymentSettings": {
    "Paymob": {
      "ApiKey": "YOUR_PAYMOB_API_KEY",
      "SecretKey": "YOUR_PAYMOB_SECRET_KEY",
      "PublicKey": "YOUR_PAYMOB_PUBLIC_KEY",
      "HmacKey": "YOUR_PAYMOB_HMAC_KEY",
      "BaseUrl": "https://accept.paymob.com/",
      "ReturnUrl": "https://www.ticketateg.com",
      "WebhookUrl": "https://api.ticketateg.com/api/webhooks/paymob",
      "IntegrationId": 0,
      "IsTestMode": true
    }
  }
}